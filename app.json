{
  "expo": {
    "name": "One Piece Chamber",
    "slug": "one-piece-chamber",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "onepiecechamber",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hennydeez.onepiecechamber",
      "infoPlist": {
        "NSCameraUsageDescription": "One Piece Chamber photographs raw cards and PSA, BGS, or TAG slabs so you can save them to your collection.",
        "NSPhotoLibraryUsageDescription": "One Piece Chamber reads a card photo from your library to save it and attempt OCR field assist."
      }
    },
    "android": {
      "package": "com.hennydeez.onepiecechamber",
      "adaptiveIcon": {
        "backgroundColor": "#0A0908",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0908"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "One Piece Chamber photographs raw cards and PSA, BGS, or TAG slabs so you can save them to your collection."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "One Piece Chamber reads a card photo from your library to save it and attempt OCR field assist.",
          "cameraPermission": "One Piece Chamber photographs cards for your collection."
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
